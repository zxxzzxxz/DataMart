# DataMart 环境变量模板
# 用法：cp .env.example .env，然后按需修改。compose 自动读取本文件做变量插值。
# 原则：开发默认值全部可跑；生产用 docker-compose.prod.yml 叠加时，带 (生产必填) 的项必须显式设置。

# ---------- Airflow 核心 ----------
# Fernet 加密密钥（生产必填）：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# API JWT 签名密钥（生产必填）：任意长随机串
AIRFLOW__API_AUTH__JWT_SECRET=
# 管理员账号（仅首次 airflow-init 时创建）
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin123

# ---------- 数据库 ----------
POSTGRES_PASSWORD=airflow
WAREHOUSE_PASSWORD=warehouse
# 流复制账号（生产必填）
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator

# ---------- Redis / MinIO / Grafana ----------
# Redis 默认无密码（仅容器网络）；如需密码同步改 compose 中 broker URL 与 redis 命令
MINIO_ROOT_USER=minioadmin
# 生产必填
MINIO_ROOT_PASSWORD=minioadmin123
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ---------- 告警通知（留空则告警仅落盘到告警中心） ----------
# ALERT_WEBHOOK_URL=http://alert-webhook:9099/alert
# REPORT_RECIPIENTS=reports@example.com
# DQ_REPORT_RECIPIENTS=data-quality@example.com

# ---------- 设计器（RBAC） ----------
# 多用户账号用 scripts/designer-add-user.sh 管理（写入 designer/users.json）
# 会话签名密钥：生产必须显式设置为长随机串（缺省回退 DESIGNER_TOKEN，仅开发可接受）
# DESIGNER_AUTH_SECRET=
# 无 users.json 时的回退单 token（等价 admin 角色）
# DESIGNER_TOKEN=designer-dev-token

# ---------- Vault（可选：Airflow secrets backend） ----------
# 先执行 scripts/vault-init.sh 完成初始化/解封/种子写入，再启用下面两项：
# AIRFLOW_SECRETS_BACKEND=airflow.providers.hashicorp.secrets.vault.VaultBackend
# VAULT_TOKEN=<vault-init.sh 输出的 root token>

# ---------- SSO（可选：Keycloak OAuth，详见 docs/sso.md） ----------
# AIRFLOW_OAUTH_ENABLED=true
# OAUTH_CLIENT_ID=airflow-web
# OAUTH_CLIENT_SECRET=datamart-dev-client-secret
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# ---------- 镜像版本（发布/回滚由 scripts/release.sh / rollback.sh / deploy.sh 维护） ----------
# IMAGE_REGISTRY=ghcr.io/<owner>
# IMAGE_TAG=latest

# ---------- Worker 弹性伸缩 ----------
# CELERY_AUTOSCALE_MIN=2
# CELERY_AUTOSCALE_MAX=8
